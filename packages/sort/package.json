{
  "name": "@cmaintz/jev-sort",
  "version": "1.0.0",
  "description": "jq for judgment — stream rows through TypeSafe AI Jev and get typed classification/score columns + confidence, at pennies per 10k.",
  "license": "MIT",
  "author": "Christoffer Maintz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CMaintz/jev-tools.git",
    "directory": "packages/sort"
  },
  "homepage": "https://github.com/CMaintz/jev-tools/tree/main/packages/sort#readme",
  "bugs": {
    "url": "https://github.com/CMaintz/jev-tools/issues"
  },
  "type": "module",
  "sideEffects": false,
  "bin": {
    "jev-sort": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. --project @cmaintz/jev-sort",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "jev",
    "typesafe",
    "llm",
    "classification",
    "bulk",
    "cli",
    "data-labeling",
    "etl",
    "jq"
  ],
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
