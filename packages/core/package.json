{
  "name": "@cmaintz/jev-core",
  "version": "0.3.0",
  "description": "Shared TypeSafe AI Jev client for the jev-tools packages: question/answer types, TypeSafe + Cloudflare providers, retrying HTTP.",
  "license": "MIT",
  "author": "Christoffer Maintz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CMaintz/jev-tools.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/CMaintz/jev-tools/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/CMaintz/jev-tools/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. --project @cmaintz/jev-core",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "jev",
    "typesafe",
    "llm",
    "client"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
