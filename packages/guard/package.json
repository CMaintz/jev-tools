{
  "name": "@cmaintz/jev-guard",
  "version": "1.1.0",
  "description": "Framework-agnostic guardrail that vets an LLM agent's proposed tool calls through TypeSafe AI Jev before they execute.",
  "license": "MIT",
  "author": "Christoffer Maintz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CMaintz/jev-tools.git",
    "directory": "packages/guard"
  },
  "homepage": "https://github.com/CMaintz/jev-tools/tree/main/packages/guard#readme",
  "bugs": {
    "url": "https://github.com/CMaintz/jev-tools/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./langchain": {
      "types": "./dist/adapters/langchain.d.ts",
      "import": "./dist/adapters/langchain.js"
    },
    "./vercel": {
      "types": "./dist/adapters/vercel-ai.d.ts",
      "import": "./dist/adapters/vercel-ai.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. --project @cmaintz/jev-guard",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "jev",
    "typesafe",
    "llm",
    "agent",
    "guardrail",
    "tool-calls",
    "safety",
    "langchain"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@cmaintz/jev-core": "^0.3.0"
  }
}
