{
  "name": "jev-tools",
  "private": true,
  "description": "TypeScript tools built on TypeSafe AI's Jev: an agent tool-call guardrail, a GitHub issue-triage Action, and a bulk classification CLI.",
  "license": "MIT",
  "author": "Christoffer Maintz",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/guard",
    "packages/triage",
    "packages/sort"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.36.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^5.0.1"
  }
}
